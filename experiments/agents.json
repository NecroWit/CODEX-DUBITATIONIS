{
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "temperature": 0.2,
  "maxTokens": 4000,
  "maxBudgetUsd": 1,
  "maxRequestUsd": 0.25,
  "maxReviewCharacters": 4500,
  "agents": [
    {
      "id": "safety",
      "model": "openai/gpt-5-mini",
      "role": "Examine safety, authority, permissions, and harmful failure modes."
    },
    {
      "id": "logic",
      "model": "anthropic/claude-haiku-4.5",
      "role": "Examine logical consistency, hidden assumptions, and counterexamples."
    },
    {
      "id": "science",
      "model": "google/gemini-2.5-flash",
      "role": "Examine falsifiability, evidence, measurable predictions, and experimental design."
    },
    {
      "id": "engineering",
      "model": "deepseek/deepseek-chat-v3.1",
      "role": "Examine feasibility, costs, reliability, and decision paralysis."
    }
  ],
  "arbiterModel": "z-ai/glm-4.7",
  "modelPrices": {
    "openai/gpt-5-mini": {
      "inputUsdPerMillionTokens": 1,
      "outputUsdPerMillionTokens": 5
    },
    "anthropic/claude-haiku-4.5": {
      "inputUsdPerMillionTokens": 2,
      "outputUsdPerMillionTokens": 10
    },
    "google/gemini-2.5-flash": {
      "inputUsdPerMillionTokens": 1,
      "outputUsdPerMillionTokens": 6
    },
    "deepseek/deepseek-chat-v3.1": {
      "inputUsdPerMillionTokens": 2,
      "outputUsdPerMillionTokens": 6
    },
    "z-ai/glm-4.7": {
      "inputUsdPerMillionTokens": 2,
      "outputUsdPerMillionTokens": 8
    }
  }
}
