{
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "temperature": 0.2,
  "maxTokens": 4000,
  "maxBudgetUsd": 1,
  "maxRequestUsd": 0.25,
  "maxReviewCharacters": 4500,
  "agents": [
    {
      "id": "safety",
      "model": "google/gemini-2.5-flash-lite",
      "role": "Examine boundaries of philosophical autonomy and cultural commitments, without imposing engineering specifications."
    },
    {
      "id": "logic",
      "model": "mistralai/mistral-medium-3.1",
      "role": "Examine logical coherence and true contradiction versus self-reference, rhetorical paradox or axiomatic choice."
    },
    {
      "id": "science",
      "model": "meta-llama/llama-4-maverick",
      "role": "Examine epistemic gains, what remains unknown, and the distinction between a self-reported value and observable behavior."
    },
    {
      "id": "engineering",
      "model": "openai/gpt-4.1-mini",
      "role": "Examine simplicity, non-redundancy, and clarity of foundational principles without implementation demands."
    }
  ],
  "arbiterModel": "deepseek/deepseek-chat-v3.1",
  "modelPrices": {
    "google/gemini-2.5-flash-lite": {
      "inputUsdPerMillionTokens": 0.4,
      "outputUsdPerMillionTokens": 1.5
    },
    "mistralai/mistral-medium-3.1": {
      "inputUsdPerMillionTokens": 1,
      "outputUsdPerMillionTokens": 4
    },
    "meta-llama/llama-4-maverick": {
      "inputUsdPerMillionTokens": 0.6,
      "outputUsdPerMillionTokens": 2
    },
    "openai/gpt-4.1-mini": {
      "inputUsdPerMillionTokens": 1,
      "outputUsdPerMillionTokens": 4
    },
    "deepseek/deepseek-chat-v3.1": {
      "inputUsdPerMillionTokens": 1,
      "outputUsdPerMillionTokens": 3
    }
  }
}
